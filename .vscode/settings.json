{
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.git": true,
    "**/.agents/plans/archive/**": false
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.git/**": true
  },
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "antigravity.sandbox.enabled": true,
  "antigravity.permissions.promptOnDestructiveActions": true,
  "antigravity.rules.enforcement": "strict",
  "antigravity.plans.activeDirectory": ".agents/plans/active",
  "antigravity.plans.archiveDirectory": ".agents/plans/archive",
  "git.autofetch": false,
  "git.refreshOnWindowFocus": false
}
